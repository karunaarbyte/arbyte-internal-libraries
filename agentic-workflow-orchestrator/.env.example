PORT=3000
WORKFLOW_STORAGE_DIR=./.workflow-store

# ── Webhook ───────────────────────────────────────────────────
# Public URL where this server is reachable (e.g. your ngrok URL)
# Used by Google Drive push notifications
WEBHOOK_BASE_URL=https://xxxx.ngrok.io

# ── LLM providers — set whichever you use ────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Google OAuth2 (Gmail + Google Drive) ─────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Scopes needed:
#   https://www.googleapis.com/auth/gmail.modify
#   https://www.googleapis.com/auth/drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Google Drive folder ID containing skill (.md) files
# Get this from the folder URL: drive.google.com/drive/folders/<FOLDER_ID>
DRIVE_SKILLS_FOLDER_ID=

# Pub/Sub topic for Gmail push notifications
# Format: projects/<project-id>/topics/<topic-name>
GMAIL_PUBSUB_TOPIC=

# Gmail address of the authenticated account — used to prevent self-reply loops
GMAIL_USER_EMAIL=

# ── Slack ─────────────────────────────────────────────────────
# Create a Slack app at: https://api.slack.com/apps
# Bot token scopes needed:
#   channels:history, channels:read, chat:write, groups:history, im:history
SLACK_BOT_TOKEN=
# Signing secret for verifying Slack interaction payloads (Interactivity & Shortcuts → Signing Secret)
SLACK_SIGNING_SECRET=
# Default channel for bot to post approvals/notifications
SLACK_DEFAULT_CHANNEL=
